# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Vectorize Hindsight ───────────────────────────────────────────────────────
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# ── Firebase (Client-side REST Auth) ─────────────────────────────────────────
# From Firebase Console → Project Settings → Your Apps → Web App → Config
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (Server-side Firestore) ────────────────────────────────
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# Option A: Path to the JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Option B: Inline JSON string (for cloud deployments / secrets managers)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Optional model overrides ──────────────────────────────────────────────────
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
