rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // admins collection: readable/writable only by authenticated users
    // (access is validated server-side via Admin SDK; these rules are a defence-in-depth layer)
    match /admins/{uid} {
      // Only the user themselves can read their own doc (client-side queries)
      allow read:  if request.auth != null && request.auth.uid == uid;
      // Writes only via Admin SDK (service account bypasses these rules)
      allow write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
